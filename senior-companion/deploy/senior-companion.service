[Unit]
Description=Senior-Korrespondenz-System (Backend)
After=network.target

[Service]
Type=simple
# Pfad anpassen, falls das Repo woanders liegt:
WorkingDirectory=/opt/senior-companion/server
ExecStart=/opt/senior-companion/server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
User=senior-companion

[Install]
WantedBy=multi-user.target
